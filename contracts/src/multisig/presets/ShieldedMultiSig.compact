// SPDX-License-Identifier: MIT
// OpenZeppelin Compact Contracts v0.3.0-alpha.1 (multisig/presets/ShieldedMultiSig.compact)

pragma language_version >= 0.23.0;

/**
 * @module ShieldedMultiSig
 * @description A shielded multisig preset composing `Signer`,
 * `ProposalManager`, and `ShieldedTreasury`. Signers approve proposals that
 * transfer shielded tokens out of the treasury once the configured threshold
 * is met.
 *
 * This preset accumulates approvals **on-chain across transactions**: each
 * signer approves independently, and any caller may execute once the threshold
 * is met.
 *
 * ## What this preset does and does not hide
 *
 * @warning "Shielded" refers to the **token rail, not to this contract's
 * bookkeeping**. Composed as it is here, almost everything about the treasury's
 * activity is public:
 *
 * - `ShieldedTreasury._coins` is exported ledger state, so every coin the
 *   treasury holds is readable in plaintext — nonce, color, value, and Merkle
 *   index along with the cumulative `_received` / `_sent` totals. Anyone can
 *   read the balance per color and identify the exact UTXO backing it.
 * - `ProposalManager._proposals` publishes every proposal's recipient, color,
 *   amount, and status, and `_nextProposalId` reveals how many exist.
 * - Signer commitments are `Set` / `Map` keys, so which signers approved a
 *   given proposal is public (see the signer-identity warning below).
 *
 * What the shielded rail still buys is that the *transfer* is a Zswap
 * operation rather than a transparent balance update, and that a signer's
 * commitment reveals no public key.
 *
 * This makes the preset a fit for a **transparent treasury** such as a DAO or similar
 * body that wants its holdings, its spending proposals, and its approvals
 * publicly auditable, with governance enforced on-chain. It is the wrong choice
 * for a treasury whose balance or payment history must stay private. For that,
 * compose `ShieldedTreasuryStateless` and forgo the on-chain proposal
 * lifecycle. `ShieldedMultiSigV2` is built that way: it composes
 * `ShieldedTreasuryStateless`, collects signatures off-chain, and imports
 * `ProposalManager` only for the `Recipient` type, not the proposal ledger.
 *
 * Consistent with the above, `executeShieldedProposal` returns the
 * `ShieldedSendResult` in plaintext. That is deliberate here: the change coin
 * is written straight back into the public `_coins` map, and the sent coin's color,
 * value, and recipient are already published by the proposal. Note this reasoning is
 * specific to `ShieldedTreasury` where returning that value from a preset built on
 * `ShieldedTreasuryStateless` would publish coin data nothing else discloses.
 *
 * ## Signer identity
 *
 * A signer is identified by the commitment
 *
 *   `signerId = persistentHash([secretKey, instanceSalt, "ShieldedMultiSig:signer:"])`
 *
 * where `secretKey` is supplied by the caller through the
 * `wit_ShieldedMultiSigSK` witness. To authenticate, a caller must prove
 * knowledge of a `secretKey` whose commitment is in the registry. The witness
 * is untrusted and may return anything, but a caller who does not hold a
 * registered `secretKey` cannot produce a preimage of a registered commitment,
 * so supplying an arbitrary value gains them nothing.
 *
 * @notice Commitments are salted with `_instanceSalt`, so the same `secretKey`
 * yields a different identity in every deployment. This is a **privacy and
 * composability trade, not a security property** — forgery is defeated by
 * requiring a preimage of a registered commitment, which holds salted or not.
 *
 * Salting scopes a signer's identity to this deployment: the same `secretKey`
 * produces a different commitment in another instance, so the two cannot be
 * correlated. That suits a standalone, ready-to-deploy preset.
 *
 * Deployers derive commitments with the `calculateSignerId` pure circuit, which
 * is callable off-chain. Each prospective signer should compute their own
 * commitment locally and share only the result — the `secretKey` never needs to
 * leave their machine.
 *
 * @warning Losing a `secretKey` permanently forfeits that signer's ability to
 * authenticate. This preset registers its signer set at construction and
 * exposes no reconfiguration circuits, so there is no recovery path: if fewer
 * than `thresh` signers retain their keys, the treasury is permanently
 * unspendable. Deployments that need key rotation must add gated
 * `Signer._addSigner` / `_removeSigner` wrappers, and should then read the
 * stale-signer-set guidance in the `Signer` module header — approvals collected
 * before a signer was removed continue to count toward the threshold.
 *
 * @warning A signer's commitment is disclosed whenever they authenticate, since
 * it is used as a `Set` / `Map` key. Which signers approved a given proposal is
 * therefore public, as is the proposal itself (see the `ProposalManager`
 * header). This preset hides the *transfer*, not the governance around it.
 *
 * @notice Approvals are deliberately NOT pruned when a proposal reaches a
 * terminal state. `_proposalApprovals[id]` and `_approvalCount[id]` persist after
 * execution or cancellation, so `_proposalApprovals` grows with the number of
 * proposals ever made and there is no cleanup path.
 *
 * That growth is the price of the audit trail, and for a transparent treasury the
 * trail is the point. Retention is safe because proposal ids are never reused.
 *
 * @notice Signer identity is witness-derived, so a contract can never act as a
 * signer: a contract caller has no witness provider. This is a permanent
 * property of the scheme rather than a limitation pending contract-to-contract
 * call support.
 */

import CompactStandardLibrary;

import "../ProposalManager" prefix Proposal_;
import "../ShieldedTreasury" prefix Treasury_;
import "../Signer"<Bytes<32>> prefix Signer_;

// Circuits are called through the prefixes above. The named imports and
// re-exports below are only for the modules' state variables, so this contract's
// ledger keys read as `_signers` / `_coins` etc. rather than
// `Signer__signers` / `ShieldedTreasury__coins`. Circuit names are deliberately
// NOT imported unprefixed, to avoid clashes.
//
// Views may be worth reinstating once contract-to-contract calls land, since a
// calling contract cannot read another contract's ledger off-chain. That is a
// deliberate deferral, not an oversight.
//
// @notice A named import binds the module's ledger field itself, not a read-only
// view, so this contract can WRITE that state directly and bypass the module's
// circuits. This preset as constructed does NOT write module state directly.
import { _signers, _signerCount, _threshold } from "../Signer"<Bytes<32>>;
import { _nextProposalId, _proposals } from "../ProposalManager";
import { _coins, _received, _sent } from "../ShieldedTreasury";

export { _signers, _signerCount, _threshold };
export { _nextProposalId, _proposals };
export { _coins, _received, _sent };

// ─── Witnesses ───────────────────────────────────────────────────────────

/**
 * @witness wit_ShieldedMultiSigSK
 * @description Returns the caller's secret key, from which their signer
 * commitment is derived.
 *
 * As with all witnesses, the contract must not assume this returns the value
 * the library author intended. Authorization rests on the caller being unable
 * to produce a preimage of a registered commitment, not on witness honesty.
 *
 * @returns {Bytes<32>} secretKey - A 32-byte cryptographically secure random value.
 */
witness wit_ShieldedMultiSigSK(): Bytes<32>;

// ─── State ───────────────────────────────────────────────────────────────

export ledger _proposalApprovals: Map<Uint<64>, Map<Bytes<32>, Boolean>>;
export ledger _approvalCount: Map<Uint<64>, Uint<8>>;

/**
 * @description Salt mixed into every signer commitment. Set once at
 * construction and `sealed`, because changing it would invalidate every
 * registered commitment and lock out all signers permanently.
 */
export sealed ledger _instanceSalt: Bytes<32>;

// ─── Constructor ─────────────────────────────────────────────────────────

/**
 * @description Deploys a fixed 2-of-3 multisig over the given signer commitments.
 *
 * @notice The threshold is hardcoded to 2 and is not a constructor parameter.
 * 2-of-3 is the only configuration of three signers that is both a real
 * threshold and survives one key loss.
 *
 * Requirements:
 *
 * - `signerCommitments` must not contain duplicates.
 * - `instanceSalt` should be cryptographically random.
 *
 * @param {Bytes<32>} instanceSalt - Random salt for signer commitment derivation.
 * @param {Vector<3, Bytes<32>>} signerCommitments - Hashed signer identities.
 */
constructor(
  instanceSalt: Bytes<32>,
  signerCommitments: Vector<3, Bytes<32>>
) {
  _instanceSalt = disclose(instanceSalt);
  Signer_initialize<3>(signerCommitments, 2);
}

// ─── Deposit ─────────────────────────────────────────────────────────────

/**
 * @description Receives a shielded coin into the treasury. Open to any caller.
 *
 * @notice Zero-value deposits are rejected here, which `ShieldedTreasury._deposit`
 * permits. A zero-value coin still creates a `_coins` entry for its color, and
 * this preset can never remove one: entries are deleted only by a full send, and
 * `_createProposal` rejects a zero amount, so no proposal can drain a zero-value
 * entry. Since `deposit` is open to any caller, that made `_coins` growable
 * without bound, one cheap transaction per color, with no pruning path.
 *
 * This does not make deposit-driven growth impossible. Dust of a color the
 * caller actually holds still creates an entry, but that costs the caller a mint
 * of their own token type, rather than being free.
 *
 * Requirements:
 *
 * - `coin.value` must be greater than 0.
 *
 * @circuitInfo k=16, rows=36932
 *
 * @param {ShieldedCoinInfo} coin - The incoming shielded coin.
 * @returns {[]} Empty tuple.
 */
export circuit deposit(coin: ShieldedCoinInfo): [] {
  assert(coin.value > 0, "ShieldedMultiSig: zero-value deposit");
  Treasury__deposit(coin);
}

// ─── Proposals ───────────────────────────────────────────────────────────

/**
 * @description Creates a proposal to transfer `amount` of `color` to `to`.
 *
 * @notice Beyond `kind`, the recipient is NOT validated, and neither the color nor
 * the amount is checked against anything spendable. A proposal naming an unfunded
 * color or an over-balance amount is created successfully and fails at execution.
 * See `cancelProposal` for retiring one that can never execute.
 *
 * @notice **A zero recipient address is a burn, and is allowed deliberately.**
 * `shieldedBurnAddress()` is defined as `left(ZswapCoinPublicKey { bytes: 0 })`,
 * and since this preset accepts only `ShieldedUser`, `toShieldedRecipient` turns a
 * zero address into exactly that value. A proposal to the zero address is
 * therefore byte-identical to a burn, not funds lost to a void, so rejecting it
 * would remove the only way this preset can destroy treasury holdings (a
 * buyback-and-burn, for example).
 *
 * The cost is that zero is also the default value of a `Bytes<32>` field, so a
 * proposal whose recipient was never set burns the funds. That risk is real but it
 * is not special: a recipient wrong by one character is equally unrecoverable, and
 * no check here can catch it, because nothing tells the contract whether a coin
 * public key is spendable. The control on where funds go is that two signers must
 * read the proposal (which is public, recipient included) and approve it.
 *
 * @notice **`RecipientKind.Contract` is rejected**, even though
 * `ProposalManager.toShieldedRecipient` supports it. A shielded coin addressed to
 * a contract must be claimed by that contract with `receiveShielded` *in the same
 * transaction*, and only the executing contract can do that. A send to any other
 * contract is rejected by the node with
 * `1010: Invalid Transaction: Custom error: 186` — measured, and independent of
 * whether that contract exists (`MockShieldedRecipientProbe.test.ts` isolates it:
 * self is accepted, a deployed foreign contract is rejected exactly like a
 * fabricated address). Claiming on the recipient's behalf needs
 * contract-to-contract calls, which do not exist yet.
 *
 * Note the platform fails closed here: nothing is stranded and the proposal is
 * not marked `Executed`, because the whole transaction is rejected. The reason to
 * block at proposal time is to fail *fast* rather than late; otherwise, signers
 * can drive a proposal to quorum, spending two approvals and their fees, only to
 * find it permanently unexecutable and needing `cancelProposal` to retire.
 *
 * Sending to a contract remains fine internally. `ShieldedTreasury` routes its
 * own change to `kernel.self()` because there the contract *is* the claimer.
 *
 * Re-enable this together with c2c support.
 *
 * Requirements:
 *
 * - Caller must be a signer.
 * - `to.kind` must be `ShieldedUser`.
 * - `amount` must be greater than 0.
 *
 * @circuitInfo k=13, rows=4965
 *
 * @param {Proposal_Recipient} to - The recipient.
 * @param {Bytes<32>} color - The token color to transfer.
 * @param {Uint<128>} amount - The amount to transfer.
 * @returns {Uint<64>} The new proposal ID.
 */
export circuit createShieldedProposal(
  to: Proposal_Recipient,
  color: Bytes<32>,
  amount: Uint<128>
): Uint<64> {
  const callerId = _computeSignerId();
  Signer_assertSigner(callerId);

  assert(
    to.kind == Proposal_RecipientKind.ShieldedUser,
    "ShieldedMultiSig: recipient must be a shielded user"
  );


  return Proposal__createProposal(to, color, amount);
}

/**
 * @description Records the caller's approval of a proposal.
 *
 * @notice Approvals accumulate on-chain across transactions, one per signer per
 * transaction. `_approvalCount` is a pinned read-modify-write, so two signers
 * approving the same proposal in the same block conflict and the loser is
 * rejected (needing a re-prove).
 *
 * Requirements:
 *
 * - Proposal must be active.
 * - Caller must be a signer.
 * - Caller must not have already approved this proposal.
 *
 * @circuitInfo k=13, rows=4455
 *
 * @param {Uint<64>} id - The proposal ID.
 * @returns {[]} Empty tuple.
 */
export circuit approveProposal(id: Uint<64>): [] {
  // Check if active
  Proposal_assertProposalActive(id);

  // Check signer
  const callerId = _computeSignerId();
  Signer_assertSigner(callerId);

  // Check if already approved
  assert(!isProposalApprovedBySigner(id, callerId), "Multisig: already approved");

  // Approve
  _approveProposal(id, callerId);
}

/**
 * @description Withdraws the caller's approval, dropping the proposal's count.
 *
 * @notice The proposal stays `Active` and can be re-armed by a later approval.
 * Use `cancelProposal` for a terminal retirement.
 *
 * Requirements:
 *
 * - Proposal must be active.
 * - Caller must be a signer.
 * - Caller must have approved this proposal.
 *
 * @circuitInfo k=13, rows=4425
 *
 * @param {Uint<64>} id - The proposal ID.
 * @returns {[]} Empty tuple.
 */
export circuit revokeApproval(id: Uint<64>): [] {
  // Check if active
  Proposal_assertProposalActive(id);

  // Check signer
  const callerId = _computeSignerId();
  Signer_assertSigner(callerId);

  // Check has approved
  assert(isProposalApprovedBySigner(id, callerId), "Multisig: not approved");

  // Revoke
  _revokeApproval(id, callerId);
}

/**
 * @description Retires a proposal permanently, so it can never execute.
 *
 * `revokeApproval` drops a proposal below the threshold but leaves it `Active`,
 * so it can be re-armed by a later approval. This is the terminal alternative:
 * a `Cancelled` proposal is rejected by `approveProposal`, `revokeApproval`, and
 * `executeShieldedProposal` alike. Its main use is retiring a proposal that
 * reached quorum but cannot execute (one naming a token color the treasury
 * does not hold or an amount above its balance) which would otherwise sit
 * `Active` indefinitely.
 *
 * @notice The authorization is deliberately narrow: the caller must be a signer
 * who has approved *this* proposal, and the proposal must already have reached
 * the threshold. Each condition removes a griefing vector, and the combination
 * grants no power that `revokeApproval` does not already grant.
 *
 * Rejecting the simpler designs on purpose: a unilateral cancel by any signer
 * would break the M-of-N guarantee, letting one signer block a transfer the
 * other M agreed on. Restricting that to below-threshold proposals does not help,
 * because approvals accumulate across transactions, so the canceller can retire each
 * proposal before a quorum forms.
 *
 * @warning A proposal that never reaches the threshold cannot be cancelled and
 * stays `Active` indefinitely. This is the accepted cost of the above: it is
 * harmless, since without a quorum it can never execute and it locks no funds.
 * Signers who want to neutralize such a proposal revoke their approvals.
 *
 * @notice The threshold guard only bites for a threshold of 2 or more, and this
 * preset's fixed threshold of 2 is part of what keeps it effective. Were the
 * threshold 1, a single approval would already constitute a quorum, so any signer
 * could approve a proposal purely to earn the right to cancel it. The
 * approve-then-cancel gambit this guard exists to prevent.
 *
 * Requirements:
 *
 * - Proposal must be active.
 * - Caller must be a signer.
 * - Caller must have approved this proposal.
 * - Approval count must meet the threshold.
 *
 * @circuitInfo k=13, rows=4451
 *
 * @param {Uint<64>} id - The proposal ID.
 * @returns {[]} Empty tuple.
 */
export circuit cancelProposal(id: Uint<64>): [] {
  // Check if active
  Proposal_assertProposalActive(id);

  // Check signer
  const callerId = _computeSignerId();
  Signer_assertSigner(callerId);

  // Check the caller is one of this proposal's approvers
  assert(isProposalApprovedBySigner(id, callerId), "Multisig: not approved");

  // Check the proposal already carries a quorum
  Signer_assertThresholdMet(getApprovalCount(id));

  // Retire
  Proposal__cancelProposal(id);
}

/**
 * @description Executes a proposal whose approval count has reached the
 * threshold.
 *
 * @notice Deliberately not gated on the caller being a signer. Once the
 * threshold is met the transfer is authorized, and its recipient and amount are
 * fixed by the proposal.
 *
 * @notice Returns the `ShieldedSendResult` in plaintext, which is public. That is
 * deliberate for this composition (see the disclosure section in the module header).
 *
 * Requirements:
 *
 * - Proposal must be active.
 * - Approval count must meet the threshold.
 * - The treasury must hold `amount` of the proposal's color.
 *
 * @circuitInfo k=15, rows=30829
 *
 * @param {Uint<64>} id - The proposal ID.
 * @returns {ShieldedSendResult} The sent coin and any change.
 */
export circuit executeShieldedProposal(
  id: Uint<64>,
): ShieldedSendResult {
  // Check if active
  Proposal_assertProposalActive(id);

  // Check threshold
  const approvalCount = getApprovalCount(id);
  Signer_assertThresholdMet(approvalCount);

  // Transfer
  const { to, color, amount } = Proposal_getProposal(id);
  const result = Treasury__send(
    Proposal_toShieldedRecipient(to),
    color,
    amount,
  );

  // Finish lifecycle
  Proposal__markExecuted(id);
  return result;
}

// ─── Internal ───────────────────────────────────────────────────────────

/**
 * @description Records `signer`'s approval of a proposal and bumps its count.
 *
 * @param {Uint<64>} id - The proposal ID.
 * @param {Bytes<32>} signer - The approving signer's commitment.
 * @returns {[]} Empty tuple.
 */
circuit _approveProposal(id: Uint<64>, signer: Bytes<32>): [] {
  if (!_proposalApprovals.member(disclose(id))) {
    _proposalApprovals.insert(disclose(id), default<Map<Bytes<32>, Boolean>>);
  }

  _proposalApprovals.lookup(disclose(id)).insert(disclose(signer), disclose(true));

  const newCount = getApprovalCount(id) + 1 as Uint<8>;
  _approvalCount.insert(disclose(id), disclose(newCount));
}

/**
 * @description Withdraws `signer`'s approval and decrements the count.
 *
 * @param {Uint<64>} id - The proposal ID.
 * @param {Bytes<32>} signer - The withdrawing signer's commitment.
 * @returns {[]} Empty tuple.
 */
circuit _revokeApproval(id: Uint<64>, signer: Bytes<32>): [] {
  _proposalApprovals.lookup(disclose(id)).remove(disclose(signer));

  const newCount = getApprovalCount(id) - 1 as Uint<8>;
  _approvalCount.insert(disclose(id), disclose(newCount));
}

/**
 * @description Returns the caller's signer commitment, derived from the
 * `wit_ShieldedMultiSigSK` witness and this deployment's salt.
 *
 * @returns {Bytes<32>} The caller's signer commitment.
 */
circuit _computeSignerId(): Bytes<32> {
  return calculateSignerId(wit_ShieldedMultiSigSK(), _instanceSalt);
}

// ─── Identity derivation ────────────────────────────────────────────────

/**
 * @description Computes a signer commitment from a secret key and salt.
 *
 * `signerId = persistentHash([secretKey, salt, "ShieldedMultiSig:signer:"])`
 *
 * Pure circuit. Callable off-chain so each prospective signer can derive their
 * own commitment locally and hand the deployer only the commitment.
 *
 * @param {Bytes<32>} secretKey - The signer's 32-byte secret key.
 * @param {Bytes<32>} salt - The deployment's instance salt.
 * @returns {Bytes<32>} The signer commitment.
 */
export pure circuit calculateSignerId(
  secretKey: Bytes<32>,
  salt: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    secretKey,
    salt,
    pad(32, "ShieldedMultiSig:signer:")
  ]);
}

// ─── Internal reads ─────────────────────────────────────────────────────

/**
 * @description Whether `signer` currently approves the proposal.
 *
 * @param {Uint<64>} id - The proposal ID.
 * @param {Bytes<32>} signer - The signer's commitment.
 * @returns {Boolean} True if that signer's approval currently stands.
 */
circuit isProposalApprovedBySigner(
  id: Uint<64>,
  signer: Bytes<32>
): Boolean {
  if (!_proposalApprovals.member(disclose(id)) || !_proposalApprovals.lookup(disclose(id)).member(disclose(signer))) {
    return false;
  }

  return _proposalApprovals.lookup(disclose(id)).lookup(disclose(signer));
}

/**
 * @description The number of approvals currently standing for a proposal.
 *
 * @notice Answers 0 for a proposal with no `_approvalCount` entry, which covers
 * both an unknown id and one nobody has approved yet.
 *
 * @param {Uint<64>} id - The proposal ID.
 * @returns {Uint<8>} The approval count, or 0 if there is no entry.
 */
circuit getApprovalCount(id: Uint<64>): Uint<8> {
  if (!_approvalCount.member(disclose(id))) {
    return 0;
  }

  return _approvalCount.lookup(disclose(id));
}
