pragma language_version >= 0.26.0;

import CompactStandardLibrary;

import "../../Eip191" prefix Eip191_;

export pure circuit personalSignHash(messageHash: Bytes<32>): Bytes<32> {
  return Eip191_personalSignHash(messageHash);
}
