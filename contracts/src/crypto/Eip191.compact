// SPDX-License-Identifier: MIT
// OpenZeppelin Compact Contracts v0.4.0-alpha.1 (crypto/Eip191.compact)

pragma language_version >= 0.26.0;

/**
 * @module Eip191
 * @description The EIP-191 `personal_sign` envelope, for verifying signatures
 * produced by Ethereum signing infrastructure.
 *
 * EVM signers do not sign a bare digest. `personal_sign` prefixes the message
 * with `"\x19Ethereum Signed Message:\n" || len` and hashes the result, so a
 * contract verifying such a signature must reproduce that outer hash or the
 * recovered key will never match.
 *
 * This module supplies the fixed-length form, where the message is itself a
 * 32-byte hash and the length field is therefore always `"32"`. Build that
 * inner hash from EVM ABI words (see `utils/EvmAbi`) so the whole preimage matches
 * what the signer hashed, byte for byte.
 *
 * @notice Requires ZKIR v3: `keccak256` is unavailable on the v2 backend.
 */
module Eip191 {
  import CompactStandardLibrary;

  /**
   * @description The 60-byte `personal_sign` preimage: the 28-byte prefix
   * followed by the 32-byte message hash. `Bytes<n>` is emitted at exactly
   * `n` bytes, so this struct hashes as the plain concatenation an EVM signer
   * produces.
   */
  struct PersonalSignPreimage {
    prefixBytes: Bytes<28>,
    messageHash: Bytes<32>
  }

  /**
   * @description `"\x19Ethereum Signed Message:\n32"` as raw bytes.
   *
   * @dev Written out as byte values rather than a string literal so the
   * non-printable `0x19` and the newline are unambiguous, and so the encoding
   * cannot drift with the compiler's string handling.
   *
   * @returns {Bytes<28>} The fixed-length `personal_sign` prefix.
   */
  pure circuit PERSONAL_SIGN_PREFIX(): Bytes<28> {
    // 0x19 "Ethereum Signed Message:" 0x0a "32"
    const raw: Vector<28, Uint<8>> = [
      25,  69, 116, 104, 101, 114, 101, 117,
     109,  32,  83, 105, 103, 110, 101, 100,
      32,  77, 101, 115, 115, 97, 103, 101,
      58,  10,  51,  50
    ];

    return raw as Bytes<28>;
  }

  /**
   * @description Wraps a 32-byte message hash in the `personal_sign`
   * envelope, yielding the digest an EVM signer actually signs.
   *
   * @constraints k=14, rows=4363 (zkir-v3)
   *
   * @param {Bytes<32>} messageHash - The hash of the operation's EVM ABI-encoded fields.
   * @returns {Bytes<32>} The digest to verify signatures against.
   */
  export pure circuit personalSignHash(messageHash: Bytes<32>): Bytes<32> {
    return keccak256<PersonalSignPreimage>(PersonalSignPreimage {
      prefixBytes: PERSONAL_SIGN_PREFIX(),
      messageHash: messageHash
    });
  }
}
