// WARNING: FOR TESTING PURPOSES ONLY.
// This contract exposes internal circuits and bypasses safety checks that the
// corresponding production contract relies on. DO NOT deploy or use this
// contract in any production application.

pragma language_version >= 0.28.0;

import CompactStandardLibrary;

import "../../interface/IAccessControl";

export { ContractAddress, Either };

/**
 * @description A contract that holds roles on an `AccessControl` instance and reaches
 * its `AsContract` circuits through cross-contract calls, so the callee sees
 * `kernel.caller()` as this contract's address. Test mock only.
 */
export ledger target: AccessControl;

constructor(accessControl: AccessControl) {
  target = disclose(accessControl);
}

circuit self(): Either<Bytes<32>, ContractAddress> {
  return right<Bytes<32>, ContractAddress>(kernel.self());
}

export circuit hasRole(roleId: Bytes<32>): Boolean {
  return target.hasRole(disclose(roleId), self());
}

export circuit grantRole(roleId: Bytes<32>, account: Either<Bytes<32>, ContractAddress>): [] {
  target.grantRoleAsContract(disclose(roleId), disclose(account));
}

export circuit revokeRole(roleId: Bytes<32>, account: Either<Bytes<32>, ContractAddress>): [] {
  target.revokeRoleAsContract(disclose(roleId), disclose(account));
}

export circuit renounceRole(roleId: Bytes<32>): [] {
  target.renounceRoleAsContract(disclose(roleId), self());
}
