// SPDX-License-Identifier: MIT
// OpenZeppelin Compact Contracts v0.5.0-alpha.2 (access/Ownable.compact)

pragma language_version >= 0.28.0;

/**
 * @module Ownable
 * @description An unshielded Ownable library.
 * This module provides a basic access control mechanism, where there is an owner
 * that can be granted exclusive access to specific circuits.
 * This approach is perfectly reasonable for contracts that have a single administrative user.
 *
 * The owner is a user or a contract, stored as an `Either<Bytes<32>, ContractAddress>`.
 * The two are authenticated differently, so every circuit that authenticates its caller
 * comes in two forms.
 *
 * A user owner is authenticated by a witness-derived identity scheme. The owner proves knowledge
 * of a secret key by injecting it via the `wit_OwnableSK` witness. The module computes
 * an account identifier as `persistentHash(secretKey)` which is a commitment that hides the key
 * while providing a stable, pseudonymous on-chain identity. `assertOnlyOwner`,
 * `transferOwnership` and `renounceOwnership` authenticate a user owner.
 *
 * Because the account identifier is `H(secretKey)` with no per-deployment salt or domain
 * separator, the same secret key produces the same identity across all contracts. This is
 * intentional. It provides a linkable pseudonymous identity analogous to Solidity's
 * `msg.sender`. Users who desire cross-contract unlinkability can use different secret keys
 * per contract at the wallet layer.
 *
 * A contract owner is authenticated by `kernel.caller()`, the address of the immediate calling
 * contract in a cross-contract call. `assertOnlyOwnerAsContract`, `transferOwnershipAsContract`
 * and `renounceOwnershipAsContract` authenticate a contract owner. They run no witness, so
 * another contract can call them through the `IOwnable` contract type, and they fail in a
 * top-level call, where there is no calling contract.
 *
 * A circuit gated with `assertOnlyOwner` is reachable by a user owner only, and one gated
 * with `assertOnlyOwnerAsContract` by a contract owner only. A contract whose owner may be
 * either kind exports a circuit for each.
 *
 * The initial owner must be set by using the `initialize` circuit during construction.
 * This can later be changed with `transferOwnership`.
 *
 * @dev Canonicalization
 * All `Either<Bytes<32>, ContractAddress>` values are canonicalized before being written
 * to the `_owner` ledger field. Canonicalization zeroes out the inactive branch of the Either,
 * ensuring consistent storage regardless of what data the inactive branch carries.
 * The single write point is `_transferOwnership`, through which all ownership changes flow.
 *
 * @dev Security Considerations:
 * - The `secretKey` must be kept private. Loss of the key prevents the owner
 *   from proving ownership. Key exposure allows impersonation.
 * - It is strongly recommended to use cryptographically secure random values for the secret key
 *   (e.g., `crypto.getRandomValues()`). Weak or predictable keys can be brute-forced.
 * - The `secretKey` is provided via the `wit_OwnableSK` witness. As with all witnesses,
 *   the contract must not assume that the witness implementation matches the developer's code.
 *   Any DApp may provide any implementation. The ZK proof system constrains what values
 *   can produce valid proofs.
 * - Ownership is unrecoverable once the owner cannot reach a circuit that transfers it.
 *   Before transferring ownership to a contract, check that this contract exports
 *   `transferOwnershipAsContract` and that the new owner has a circuit calling it.
 *   Circuits gated with `assertOnlyOwner` stop being reachable once the owner is a contract,
 *   and circuits gated with `assertOnlyOwnerAsContract` once the owner is a user.
 */
module Ownable {
  import CompactStandardLibrary;
  import "../utils/Utils" prefix Utils_;

  /**
   * @description Initialization flag, tracked per-module to avoid the compiler's
   * shared transitive-dependency state bug (LFDT-Minokawa/compact#270). See the
   * Initializable module for rationale.
   */
  export ledger _isInitialized: Boolean;

  /**
   * @description The current owner, canonicalized on write. A `left` holds an
   * account identifier, stored as supplied and never checked against the secret
   * key it should derive from; a `right` holds a contract address. The zero
   * value means ownership has been renounced.
   */
  export ledger _owner: Either<Bytes<32>, ContractAddress>;

  /**
   * @witness wit_OwnableSK
   * @description Returns the caller's secret key used in deriving the account identifier.
   *
   * The same key produces the same account identifier across all contracts. Users who
   * desire cross-contract unlinkability should use different keys per contract.
   *
   * @returns {Bytes<32>} secretKey - A 32-byte cryptographically secure random value.
   */
  witness wit_OwnableSK(): Bytes<32>;

  /**
   * @description Initializes the contract by setting the `initialOwner`.
   * This must be called in the contract's constructor.
   *
   * @constraints k=9, rows=272
   *
   * Requirements:
   *
   * - Contract is not already initialized.
   * - `initialOwner` is not the zero address.
   *
   * @param {Either<Bytes<32>, ContractAddress>} initialOwner - The initial owner of the contract.
   * @returns {[]} Empty tuple.
   */
  export circuit initialize(initialOwner: Either<Bytes<32>, ContractAddress>): [] {
    assertNotInitialized();
    _isInitialized = true;
    assert(!Utils_isTargetZero(initialOwner), "Ownable: invalid initial owner");
    _transferOwnership(initialOwner);
  }

  /**
   * @description Asserts that the contract has been initialized, throwing an error if not.
   *
   * Requirements:
   *
   * - Contract must be initialized.
   *
   * @return {[]} - Empty tuple.
   */
  circuit assertInitialized(): [] {
    assert(_isInitialized, "Ownable: contract not initialized");
  }

  /**
   * @description Asserts that the contract has not been initialized, throwing an error if it has.
   *
   * Requirements:
   *
   * - Contract must not be initialized.
   *
   * @return {[]} - Empty tuple.
   */
  circuit assertNotInitialized(): [] {
    assert(!_isInitialized, "Ownable: contract already initialized");
  }

  /**
   * @description Returns the current contract owner.
   *
   * @constraints k=7, rows=99
   *
   * Requirements:
   *
   * - Contract is initialized.
   *
   * @returns {Either<Bytes<32>, ContractAddress>} - The contract owner.
   */
  export circuit owner(): Either<Bytes<32>, ContractAddress> {
    assertInitialized();
    return _owner;
  }

  /**
   * @description Transfers ownership of the contract to `newOwner`, a user or a contract.
   * The caller is a user owner; a contract owner uses `transferOwnershipAsContract`.
   *
   * @constraints k=13, rows=2267
   *
   * Requirements:
   *
   * - Contract is initialized.
   * - The caller is the current contract owner.
   * - `newOwner` is not the zero address.
   *
   * @param {Either<Bytes<32>, ContractAddress>} newOwner - The new owner.
   * @returns {[]} Empty tuple.
   */
  export circuit transferOwnership(newOwner: Either<Bytes<32>, ContractAddress>): [] {
    assertInitialized();
    assertOnlyOwner();
    assert(!Utils_isTargetZero(newOwner), "Ownable: invalid new owner");
    _transferOwnership(newOwner);
  }

  /**
   * @description Transfers ownership of the contract to `newOwner`, a user or a contract.
   * The caller is a contract owner; a user owner uses `transferOwnership`.
   *
   * @constraints k=9, rows=382
   *
   * Requirements:
   *
   * - Contract is initialized.
   * - The calling contract is the current contract owner.
   * - `newOwner` is not the zero address.
   *
   * @param {Either<Bytes<32>, ContractAddress>} newOwner - The new owner.
   * @returns {[]} Empty tuple.
   */
  export circuit transferOwnershipAsContract(newOwner: Either<Bytes<32>, ContractAddress>): [] {
    assertInitialized();
    assertOnlyOwnerAsContract();
    assert(!Utils_isTargetZero(newOwner), "Ownable: invalid new owner");
    _transferOwnership(newOwner);
  }

  /**
   * @description Leaves the contract without an owner.
   * It will not be possible to call owner-gated circuits anymore.
   * The caller is a user owner; a contract owner uses `renounceOwnershipAsContract`.
   *
   * @constraints k=13, rows=2071
   *
   * Requirements:
   *
   * - Contract is initialized.
   * - The caller is the current contract owner.
   *
   * @returns {[]} Empty tuple.
   */
  export circuit renounceOwnership(): [] {
    assertInitialized();
    assertOnlyOwner();
    _transferOwnership(Utils_zeroAccount());
  }

  /**
   * @description Leaves the contract without an owner.
   * It will not be possible to call owner-gated circuits anymore.
   * The caller is a contract owner; a user owner uses `renounceOwnership`.
   *
   * @constraints k=8, rows=186
   *
   * Requirements:
   *
   * - Contract is initialized.
   * - The calling contract is the current contract owner.
   *
   * @returns {[]} Empty tuple.
   */
  export circuit renounceOwnershipAsContract(): [] {
    assertInitialized();
    assertOnlyOwnerAsContract();
    _transferOwnership(Utils_zeroAccount());
  }

  /**
   * @description Throws if called by any account other than a user owner.
   * Use this to restrict access of specific circuits to a user owner.
   *
   * The caller's identity is derived from the `wit_OwnableSK` witness as
   * `persistentHash(secretKey)`.
   *
   * @notice This check fails for every caller while the owner is a contract.
   * Use `assertOnlyOwnerAsContract` to admit a contract owner.
   *
   * @constraints k=13, rows=2032
   *
   * Requirements:
   *
   * - Contract is initialized.
   * - The caller is the current contract owner.
   *
   * @returns {[]} Empty tuple.
   */
  export circuit assertOnlyOwner(): [] {
    assertInitialized();
    assert(_owner.is_left && _computeAccountId() == _owner.left,
           "Ownable: caller is not the owner");
  }

  /**
   * @description Throws if called by any contract other than a contract owner.
   * Use this to restrict access of specific circuits to a contract owner.
   *
   * The caller is `kernel.caller()`, the address of the immediate calling contract
   * in a cross-contract call. The circuit runs no witness.
   *
   * @notice This check fails in a top-level call and for every caller while the
   * owner is a user. Use `assertOnlyOwner` to admit a user owner.
   *
   * @constraints k=8, rows=147
   *
   * Requirements:
   *
   * - Contract is initialized.
   * - The calling contract is the current contract owner.
   *
   * @returns {[]} Empty tuple.
   */
  export circuit assertOnlyOwnerAsContract(): [] {
    assertInitialized();
    const caller = Utils_contractCaller();
    assert(!_owner.is_left && caller.is_some && caller.value == _owner.right,
           "Ownable: caller is not the owner");
  }

  /**
   * @description Transfers ownership of the contract to `newOwner` without
   * enforcing permission checks on the caller. Accepts the zero value, which
   * renounces ownership.
   *
   * @constraints k=8, rows=234
   *
   * Requirements:
   *
   * - Contract is initialized.
   *
   * @param {Either<Bytes<32>, ContractAddress>} newOwner - The new owner.
   * @returns {[]} Empty tuple.
   */
  export circuit _transferOwnership(newOwner: Either<Bytes<32>, ContractAddress>): [] {
    assertInitialized();
    const canonAcct = Utils_canonicalize<Bytes<32>, ContractAddress>(newOwner);
    _owner = disclose(canonAcct);
  }

  /**
   * @description Computes the caller's account identifier from the `wit_OwnableSK` witness.
   *
   * ## ID Derivation
   * `accountId = persistentHash(secretKey)`
   *
   * The result is a 32-byte commitment that uniquely identifies the caller.
   *
   * @returns {Bytes<32>} accountId - The computed account identifier.
   */
  circuit _computeAccountId(): Bytes<32> {
    return Utils_computeAccountId(wit_OwnableSK());
  }
}
