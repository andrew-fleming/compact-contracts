// OpenZeppelin Compact Contracts v0.5.0-alpha.2 (access/interface/IOwnable.compact)

pragma language_version >= 0.28.0;

/**
 * @module IOwnable
 * @description The contract type of an `Ownable` contract, as another contract sees it.
 *
 * Import it to hold a reference to an `Ownable` contract and call its circuits
 * cross-contract, and declare `contract implements Ownable;` in a contract that exports
 * these circuits so the compiler checks the names and types match.
 *
 * It lists the circuits a calling contract can use: the `owner` read and the `AsContract`
 * forms, which authenticate the calling contract and run no witness. The guards
 * `assertOnlyOwner` and `assertOnlyOwnerAsContract` are not part of the type: a contract
 * composes them into its own circuits.
 */
module IOwnable {
  import CompactStandardLibrary;

  export contract Ownable {
    circuit owner(): Either<Bytes<32>, ContractAddress>;
    circuit transferOwnershipAsContract(newOwner: Either<Bytes<32>, ContractAddress>): [];
    circuit renounceOwnershipAsContract(): [];
  }
}
