// SPDX-License-Identifier: MIT

// WARNING: FOR TESTING PURPOSES ONLY. Intentionally writes the token module's
// exported `_escrow` map from the composing contract, bypassing `approve`.
// DO NOT use this pattern in production.

// Top-level contract composing the production `ConfidentialFungibleToken`
// module with one extra entry point, `plantEscrow`, which inserts a `default`
// escrow entry (an encryption of zero) for any (owner, spender) pair without
// going through `approve`. Every exported ledger field is writable by a
// composing contract, so this is a reachable state. The `escrowBypass` spec
// drives it to assert that `_spendEscrow` then stops on its own registration
// guards rather than on a missing-key read of `_encryptionKeys`.
pragma language_version >= 0.26.0;

import CompactStandardLibrary;

import "../../../src/token/ConfidentialFungibleToken" prefix Token_;
import "../../../src/crypto/ElGamal" prefix ElGamal_;

export { Token_EscrowEntry, ElGamal_Ciphertext };
export { Token__encryptionKeys, Token__escrow };

constructor(
    name_: Opaque<"string">,
    symbol_: Opaque<"string">,
    decimals_: Uint<8>,
) {
  Token_initialize(name_, symbol_, decimals_);
}

export circuit register(): Bytes<32> {
  return Token_register();
}

export circuit allowance(owner: Bytes<32>, spender: Bytes<32>): Token_EscrowEntry {
  return Token_allowance(owner, spender);
}

export circuit transferFrom(
    fromAddress: Bytes<32>,
    to: Bytes<32>,
    value: Uint<128>
): Bytes<32> {
  return Token_transferFrom(fromAddress, to, value);
}

export circuit _burnFrom(fromAddress: Bytes<32>, value: Uint<128>): Bytes<32> {
  return Token__burnFrom(fromAddress, value);
}

// The bypass: a direct write to the module's exported escrow map.
export circuit plantEscrow(owner: Bytes<32>, spender: Bytes<32>): [] {
  if (!Token__escrow.member(disclose(owner))) {
    Token__escrow.insert(disclose(owner), default<Map<Bytes<32>, Token_EscrowEntry>>);
  }
  Token__escrow.lookup(disclose(owner)).insert(disclose(spender), default<Token_EscrowEntry>);
}
